# Exemple de variables d'environnement (aucune n'est obligatoire).
# Copiez ce fichier en .env pour un usage local ; ne versionnez jamais .env.

# Adresse publique du site, utilisée pour le sitemap et les métadonnées de partage.
# Sur Netlify, la variable URL est fournie automatiquement : SITE_URL n'est utile
# que pour forcer une autre adresse (par exemple le domaine officiel).
# SITE_URL=https://www.exemple.org

# Afficher les notes éditoriales internes (« à valider ») dans les pages.
# Activées automatiquement avec `npm run dev`. À réserver aux aperçus de relecture.
# PUBLIC_NOTES_EDITORIALES=true
