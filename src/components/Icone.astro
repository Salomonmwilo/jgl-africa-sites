---
/**
 * Pictogrammes décoratifs (dessinés pour le projet, trait simple).
 * Toujours décoratifs : le sens est porté par le texte qui les accompagne.
 */
import type { IconeNom } from '../data/institution';

interface Props {
  nom: IconeNom;
  taille?: number;
}

const { nom, taille = 40 } = Astro.props;

const traces: Record<IconeNom, string> = {
  balance:
    'M24 6v34M14 40h20M10 12h28M10 12l-6 13a6 6 0 0 0 12 0zM38 12l-6 13a6 6 0 0 0 12 0z',
  colombe:
    'M6 28c8 0 12-4 16-10 3 6 9 8 16 6-3 8-11 12-20 12-5 0-9-2-12-8zM22 18c-2-5-6-8-12-9 1 6 4 10 9 12M38 24l6-3',
  bouclier: 'M24 4l16 6v12c0 10-7 18-16 22C15 40 8 32 8 22V10zM17 24l5 5 9-10',
  pilier: 'M6 16L24 6l18 10zM10 20v16M19 20v16M29 20v16M38 20v16M6 40h36M4 44h40',
  livre: 'M24 12c-5-4-12-5-18-4v28c6-1 13 0 18 4 5-4 12-5 18-4V8c-6-1-13 0-18 4zM24 12v28',
  mains: 'M6 30l8-8c3-3 7-3 10 0l2 2M42 30l-8-8M14 22l10 10c2 2 5 2 7 0l11-11M6 30l10 10h8',
  megaphone: 'M8 20v8h6l14 8V12l-14 8zM14 28l3 12h5l-2-10M34 18c3 2 3 10 0 12M38 14c6 4 6 16 0 20',
  boussole: 'M24 44a20 20 0 1 0 0-40 20 20 0 0 0 0 40zM31 17l-4 10-10 4 4-10z',
  coeur: 'M24 41S6 30 6 17a9 9 0 0 1 18-2 9 9 0 0 1 18 2c0 13-18 24-18 24z',
};
---

<svg
  class="icone"
  viewBox="0 0 48 48"
  width={taille}
  height={taille}
  aria-hidden="true"
  focusable="false"
>
  <path d={traces[nom]} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
